---
import BaseLayout from "../layouts/BaseLayout.astro";
import DSButton from "../components/DSButton.astro";
import DSCTA from "../components/DSCTA.astro";
import DSHeadshot from "../components/DSHeadshot.astro";
import PageHero from "../components/PageHero.astro";
import { greenery } from "../lib/photos";

const timeline = [
  ["A background in finance", "I spent years working in financial and leadership roles, where I became interested in the people behind the work."],
  ["A deeper curiosity", "I’m fascinated by how the thoughts and beliefs we carry, often beneath the surface and outside our awareness, shape how we see ourselves, relate to others, and experience life."],
  ["My counselling practice", "Today, I offer an intentional space to explore more deeply whatever you’re navigating. I love this work and feel honoured to support you in finding clarity and compassion, and in discovering new ways to navigate life with greater ease and purpose."],
];

const credentials = [
  "Registered Clinical Counsellor (RCC #20966)",
  "Canadian Certified Counsellor (CCC #11264375)",
  "Master of Counselling, City University",
  "Chartered Professional Accountant (CPA, CGA)",
  "Master of Professional Accounting, University of Saskatchewan",
  "Bachelor of Commerce, University of Victoria",
];
---
<BaseLayout title="About Jamie | Jamie Barbon Counselling" description="Learn about Jamie Barbon’s background, counselling approach, and professional credentials.">
  <PageHero photo={greenery.about} title="A thoughtful space to work through what matters." />

  <DSHeadshot><p>I’m Jamie Barbon, a Registered Clinical Counsellor and Canadian Certified Counsellor.</p></DSHeadshot>

  <section class="ds-section ds-section--subtle"><div class="ds-container ds-prose-section"><div class="ds-heading"><span class="ds-eyebrow">My story</span><h2>How I came to this work</h2></div><div class="ds-prose"><p>I came to counselling after years of working in financial and leadership roles, where I found myself increasingly interested in the people behind the work—what motivates us, what holds us back, and how we navigate, grow, and find our way through the challenges and discomfort that life can bring.</p><p>I’m drawn to the real conversations that help us slow down, make sense of what’s happening, and notice the connections between our thoughts, emotions, and patterns, and how they shape our experience of life. I’ve come to see that the beliefs we hold about ourselves, our relationships, and the world around us can sometimes keep us stuck and feeling disconnected. Exploring those beliefs can open up space for new insights and possibilities, changing how we understand ourselves, relate to others, and navigate life’s challenges.</p><p>I strive to create a counselling space that feels welcoming, genuine, and grounded. One of the things I value most about this work is the opportunity to connect with others. I listen closely, ask thoughtful questions, and work alongside you to find ways forward that feel right for you.</p></div></div></section>

  <section class="ds-section"><div class="ds-container ds-prose-section"><div class="ds-heading"><span class="ds-eyebrow">My approach</span><h2>Work that is tailored to you.</h2></div><div class="ds-prose"><p>What feels supportive and helpful can look different for each of us and evolve throughout life’s different stages. My approach is integrative in that I draw on a range of therapeutic practices, guided by your needs, preferences, and what feels meaningful to explore. These may include Cognitive Behavioural Therapy (CBT), Inquiry-Based Stress Reduction (IBSR - The Work of Byron Katie), Acceptance and Commitment Therapy (ACT), mindfulness, narrative, solution-focused, and somatic practices.</p><DSButton href="/contact" variant="secondary">Get in touch</DSButton></div></div></section>

  <section class="ds-section ds-section--sm"><div class="ds-container"><div class="ds-timeline-panel"><div class="ds-timeline-intro"><h2>How I got here</h2><p>My path to counselling grew from a curiosity about people, what shapes our experiences, and how a deeper understanding of ourselves can open up new possibilities.</p></div><div class="ds-timeline">{timeline.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div></div></section>

  <section class="ds-section ds-section--subtle"><div class="ds-container ds-credentials"><div class="ds-heading"><span class="ds-eyebrow">Professional background</span><h2>Education &amp; credentials</h2><p>Professional member of the Canadian Counselling and Psychotherapy Association, BC Association of Clinical Counsellors, and Chartered Professional Accountants of BC.</p></div><ul>{credentials.map(credential => <li>{credential}</li>)}</ul></div></section>

  <DSCTA title="Let’s connect." text="Reach out with any questions or to arrange a virtual counselling session." />
  <script>
    const timeline = document.querySelector<HTMLElement>('.ds-timeline');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.ds-timeline article'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function update() {
      if (!timeline || !items.length) return;
      const end = timeline.clientHeight;
      const progress = reducedMotion ? end : Math.max(0, Math.min(end, innerHeight * .6 - timeline.getBoundingClientRect().top));
      timeline.style.setProperty('--timeline-progress', `${progress}px`);
      items.forEach(item => item.classList.toggle('is-active', progress >= item.offsetTop + 8));
    }

    if (reducedMotion) {
      update();
    } else {
      let ticking = false;
      const scheduleUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      addEventListener('scroll', scheduleUpdate, { passive: true });
      addEventListener('resize', scheduleUpdate);
      update();
    }
  </script>
</BaseLayout>
