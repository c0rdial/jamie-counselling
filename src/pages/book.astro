---
import BaseLayout from "../layouts/BaseLayout.astro";
import DSButton from "../components/DSButton.astro";
const CALENDLY_URL = "https://calendly.com/jamie-counselling/intro-call";
---
<BaseLayout title="Book a call — Jamie Sulek" description="Schedule a free 15-minute consultation with Jamie.">
  <section class="ds-section ds-page-hero"><div class="ds-container ds-heading ds-heading--center"><h1>Find a time that feels right</h1><p>Pick a free 15-minute consultation below. No pressure — it's a chance to ask anything and see if we're a good fit.</p></div></section>
  <section class="ds-section ds-section--sm"><div class="ds-container ds-book-grid"><div class="ds-book-widget"><div class="calendly-inline-widget" data-url={`${CALENDLY_URL}?hide_gdpr_banner=1&background_color=fcfaf3&text_color=2b2a22&primary_color=1b3129`} style="min-width:320px;height:680px;"></div></div><aside class="ds-book-aside"><div class="ds-resource-panel"><h2>What to expect</h2><ul><li>A free, no-pressure 15-minute call</li><li>We'll talk about what's bringing you here</li><li>You can ask anything — fees, approach, fit</li><li>Zero commitment to book a full session</li></ul></div><div class="ds-resource-panel"><h2>Prefer to message?</h2><p>If picking a time feels like too much right now, that's okay. Send a note and I'll reply within 24–48 hours.</p><DSButton href="/contact" variant="secondary">Use the contact form</DSButton></div><p>If you're in immediate crisis, please call <strong>988</strong> (Canada-wide) or visit your nearest emergency room.</p></aside></div></section>
  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
</BaseLayout>
