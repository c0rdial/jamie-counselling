---
import BaseLayout from "../layouts/BaseLayout.astro";
import DSButton from "../components/DSButton.astro";
import DSMedia from "../components/DSMedia.astro";
import DSCTA from "../components/DSCTA.astro";
import { data } from "../lib/designData";
import { safeFetch } from "../lib/sanity";
import { PortableText } from "astro-portabletext";
const cmsServices = await safeFetch(`*[_type == "service"] | order(order asc){ title, shortDescription, description, image }`) ?? [];
const settings = await safeFetch(`*[_type == "siteSettings"][0]{ ogImage }`);
const services = cmsServices.length ? cmsServices : data.services;
---
<BaseLayout title="Services — Jamie Sulek" description="Pathways to clarity and balance through wellness coaching.">
  <section class="ds-section ds-page-hero"><div class="ds-container ds-heading ds-heading--center"><h1>Pathways to clarity and balance.</h1><p>My sessions are designed to help you peel back the layers of burnout and reconnect with your core purpose through a blend of somatic tools.</p></div></section>
  <section class="ds-section ds-section--sm"><div class="ds-container ds-service-list">{services.map((s: any) => <article class="ds-service-card"><DSMedia image={s.image} label={s.title} ratio="4 / 5" /><div class="ds-service-card__body"><div style="display:grid;gap:14px"><span class="ds-tag">{s.duration ?? "50 Minutes"}</span><h2>{s.title}</h2><p>{s.shortDescription ?? (typeof s.description === "string" ? s.description : "")}</p>{s.price && <div style="font:400 36px/1 var(--font-display)">{s.price}</div>}</div>{s.description && Array.isArray(s.description) && <div class="ds-lead"><PortableText value={s.description} /></div>}<div><div class="ds-service-list-heading">Includes</div><ul class="ds-service-list-items">{data.includes.map((item: any) => <li><span><strong>{item.label}:</strong> {item.text}</span></li>)}</ul></div><div><div class="ds-service-list-heading">Who is it for</div><ul class="ds-service-list-items">{data.audience.map((item: any) => <li><span><strong>{item.label}:</strong> {item.text}</span></li>)}</ul></div><div><DSButton href="/contact">Explore Session</DSButton></div></div></article>)}</div></section>
  <DSCTA image={settings?.ogImage} />
</BaseLayout>
