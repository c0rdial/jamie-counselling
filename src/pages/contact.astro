---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.tsx";
import { safeFetch } from "../lib/sanity";

const settings = await safeFetch(
  `*[_type == "siteSettings"][0]{ contactEmail, contactPhone, location }`
);
const formId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "placeholder";

const email = settings?.contactEmail ?? "hello@jamiecounselling.ca";
const phone = settings?.contactPhone ?? "(604) 555-0123";
const location = settings?.location ?? "British Columbia (online sessions)";
---

<BaseLayout title="Contact — Jamie Counselling" description="Get in touch to book a consultation">
  <section class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-xs uppercase tracking-[0.2em] text-accent font-semibold mb-3 reveal">Get in touch</p>
      <h1 class="font-heading text-4xl md:text-5xl text-text-primary leading-tight mb-5 reveal" style="transition-delay: 80ms;">
        Let's start a conversation
      </h1>
      <p class="text-text-body text-[17px] max-w-xl mx-auto leading-relaxed reveal" style="transition-delay: 160ms;">
        Reaching out is the hardest part — and you've already found your way here. Send me a message, and I'll be in touch within 24-48 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-14 max-w-4xl mx-auto">
      <!-- Form -->
      <div class="lg:col-span-3 reveal" style="transition-delay: 100ms;">
        <div class="p-8 md:p-10 bg-white/70 backdrop-blur-sm rounded-2xl border border-border/50">
          <ContactForm client:load formId={formId} />
        </div>
      </div>

      <!-- Contact info sidebar -->
      <div class="lg:col-span-2 space-y-8 reveal" style="transition-delay: 200ms;">
        <!-- Info cards -->
        <div class="p-6 rounded-2xl bg-surface/60 border border-border/40">
          <div class="flex items-start gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-accent-pale/60 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <path d="M22 6l-10 7L2 6"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-text-muted uppercase tracking-wider font-semibold mb-1">Email</p>
              <a href={`mailto:${email}`} class="text-[15px] text-accent hover:text-accent-dark transition-colors">
                {email}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-accent-pale/60 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-text-muted uppercase tracking-wider font-semibold mb-1">Phone</p>
              <a href={`tel:${phone}`} class="text-[15px] text-accent hover:text-accent-dark transition-colors">
                {phone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-accent-pale/60 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-text-muted uppercase tracking-wider font-semibold mb-1">Location</p>
              <p class="text-[15px] text-text-body">{location}</p>
            </div>
          </div>
        </div>

        <!-- Reassurance -->
        <div class="p-6 rounded-2xl bg-accent-pale/30 border border-accent/10">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <p class="text-sm font-semibold text-accent-dark">Not sure what to say?</p>
          </div>
          <p class="text-[14px] text-text-body leading-relaxed">
            You don't need to have it all figured out. A simple "I'd like to learn more about counselling" is a perfectly wonderful place to start.
          </p>
        </div>

        <!-- Session info -->
        <div class="p-6 rounded-2xl bg-white/60 border border-border/40">
          <p class="text-sm font-semibold text-text-primary mb-3">What to expect</p>
          <ul class="space-y-2.5 text-[14px] text-text-body">
            <li class="flex items-start gap-2">
              <span class="botanical-dot mt-1.5 shrink-0" />
              Free 15-minute consultation
            </li>
            <li class="flex items-start gap-2">
              <span class="botanical-dot mt-1.5 shrink-0" />
              50-minute sessions via secure video
            </li>
            <li class="flex items-start gap-2">
              <span class="botanical-dot mt-1.5 shrink-0" />
              Flexible scheduling, including evenings
            </li>
            <li class="flex items-start gap-2">
              <span class="botanical-dot mt-1.5 shrink-0" />
              Direct billing for most extended health plans
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
