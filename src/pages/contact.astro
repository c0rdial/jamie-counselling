---
import BaseLayout from "../layouts/BaseLayout.astro";
import DSMedia from "../components/DSMedia.astro";
import DSCTA from "../components/DSCTA.astro";
import ContactForm from "../components/ContactForm.tsx";
import { safeFetch } from "../lib/sanity";
const settings = await safeFetch(`*[_type == "siteSettings"][0]{ contactEmail, location, aboutImage, ogImage }`);
const email = settings?.contactEmail ?? "jamiesulek008@gmail.com";
const location = settings?.location ?? "Victoria, British Columbia, Canada";
const formId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "placeholder";
---
<BaseLayout title="Contact — Jamie Sulek" description="Get in touch with Jamie Sulek.">
  <section class="ds-section ds-page-hero"><div class="ds-container ds-contact-grid"><div class="ds-contact-info"><div class="ds-heading"><h1>Contact me.</h1></div><div><div class="ds-info-row"><span class="ds-info-icon" aria-hidden="true">✉</span><div><strong>EMAIL</strong><a href={`mailto:${email}`}>{email}</a></div></div><div class="ds-info-row"><span class="ds-info-icon" aria-hidden="true">⌖</span><div><strong>LOCATION</strong><p>{location}</p></div></div></div><DSMedia label="Studio exterior" ratio="16 / 10" /></div><ContactForm client:load formId={formId} /></div></section>
  <DSCTA image={settings?.ogImage} />
</BaseLayout>
