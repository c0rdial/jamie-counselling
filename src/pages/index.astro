---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import DSButton from "../components/DSButton.astro";
import DSCTA from "../components/DSCTA.astro";
import jamieHero from "../assets/jamie-hero.jpg";

const areas = [
  "Anxiety, stress & burnout",
  "Relationships & family dynamics",
  "Life transitions, grief & loss",
  "Perfectionism & self-doubt",
  "Parenting & step-parenting",
  "Work, performance & financial stress",
];
---
<BaseLayout title="Jamie Barbon Counselling | Virtual counselling" description="Warm, practical virtual counselling for adults navigating anxiety, relationships, loss, stress, and life transitions.">
  <section class="ds-section ds-section--sm">
    <div class="ds-container ds-hero">
      <div class="ds-hero__copy">
        <span class="ds-eyebrow">Jamie Barbon Counselling</span>
        <h1 class="ds-display">Support to meet life’s challenges with <em>clarity, compassion, and <strong>purpose</strong>.</em></h1>
        <p class="ds-lead">Welcome, I’m Jamie. I offer virtual counselling for adults navigating difficult feelings, relationships, work, and change. Together, we can make sense of what feels hard and find a way forward that fits you.</p>
        <DSButton href="/contact" size="lg">Get in touch</DSButton>
      </div>
      <div class="ds-media ds-hero__portrait">
        <Image src={jamieHero} alt="Jamie Barbon seated for a portrait" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="ds-section ds-section--subtle" id="support">
    <div class="ds-container ds-simple-section">
      <div class="ds-heading"><span class="ds-eyebrow">Where counselling can help</span><h2>Whatever you’re carrying, you don’t have to sort through it alone.</h2><p>Life can look manageable on the outside while feeling heavy or unclear underneath. Counselling offers space to pause, reflect, and reconnect with what matters most to you.</p></div>
      <ul class="ds-area-grid">{areas.map(area => <li>{area}</li>)}</ul>
    </div>
  </section>

  <section class="ds-section">
    <div class="ds-container ds-intro-panel">
      <div class="ds-heading"><span class="ds-eyebrow">A bit about me</span><h2>Warm, grounded, practical counselling.</h2></div>
      <div class="ds-intro-panel__copy"><p>I came to counselling after years in finance and leadership, where I became increasingly interested in the people behind the work. I listen closely, ask thoughtful questions, and work with you to understand what you’re facing.</p><p>Our conversations focus on your strengths, values, and the steps that feel meaningful and workable in your life.</p><DSButton href="/about" variant="secondary">More about my approach</DSButton></div>
    </div>
  </section>

  <section class="ds-section ds-section--subtle">
    <div class="ds-container ds-session-strip"><div><span class="ds-eyebrow">Sessions</span><h2>Virtual counselling on weekdays.</h2><p>Appointments include 6:00 AM Pacific sessions two days a week.</p></div><div class="ds-session-strip__fees"><p><strong>50 minutes</strong><span>$150</span></p><p><strong>75 minutes</strong><span>$200</span></p></div></div>
  </section>

  <DSCTA title="Ready to start a conversation?" text="Reach out to ask a question or find a time to meet." />
</BaseLayout>
