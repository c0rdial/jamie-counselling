---
import BaseLayout from "../layouts/BaseLayout.astro";
import DSButton from "../components/DSButton.astro";
import DSCTA from "../components/DSCTA.astro";
import PageHero from "../components/PageHero.astro";
import { Image } from "astro:assets";
import { greenery } from "../lib/photos";
import jamiePortrait from "../assets/jamie-portrait-dark.jpg";

const areas = [
  "Anxiety, stress & burnout",
  "Relationships & family dynamics",
  "Life transitions, grief & loss",
  "Perfectionism & self-doubt",
  "Parenting & step-parenting",
  "Work and academic performance",
  "Financial stress",
];
---
<BaseLayout title="Jamie Barbon Counselling | Virtual counselling" description="Warm, practical virtual counselling for adults navigating anxiety, relationships, loss, stress, and life transitions.">
  <PageHero photo={greenery.home} title="Meet life’s challenges" size="full">
    <p>With clarity, compassion, and purpose.</p>
    <DSButton href="/contact" variant="light" size="lg">Get in touch</DSButton>
  </PageHero>

  <section class="ds-section">
    <div class="ds-container ds-welcome">
      <div class="ds-heading"><h2>Welcome, I’m Jamie.</h2><p>Whatever you’re navigating, counselling can offer an intentional space to pause, reflect, and reconnect with what matters most to you. From there, new possibilities and ways forward can emerge.</p></div>
      <div class="ds-media ds-welcome__portrait">
        <Image src={jamiePortrait} alt="Jamie Barbon seated in a dark blazer" widths={[400, 800]} sizes="(max-width: 900px) 80vw, 420px" format="webp" />
      </div>
    </div>
  </section>

  <section class="ds-section ds-section--subtle" id="support">
    <div class="ds-container ds-simple-section">
      <div class="ds-heading"><span class="ds-eyebrow">Where counselling can help</span><h2>Change begins with connection.</h2><p>Life doesn’t always feel the way it looks on the outside. You might be holding a lot—showing up, pushing forward, keeping things together—while something underneath feels off, heavy, or unclear.</p><p>At times, you may find yourself navigating anxiety, depression, grief and loss, or periods of growth and transition that feel both meaningful and overwhelming. You might be re-evaluating your path, facing shifts in work or relationships, or carrying stress—including financial stress—that quietly shapes how you move through your day-to-day life.</p><p>Sometimes, the first step toward change is simply being willing to talk about it.</p></div>
      <ul class="ds-area-grid">{areas.map(area => <li>{area}</li>)}</ul>
    </div>
  </section>

  <section class="ds-section">
    <div class="ds-container ds-intro-panel">
      <div class="ds-heading"><span class="ds-eyebrow">A bit about me</span><h2>Warm, engaging, and real.</h2></div>
      <div class="ds-intro-panel__copy"><p>Just honest conversation, useful tools, and a space to explore what matters. Together, we’ll deepen your understanding of yourself, explore what might be getting in the way of what you most want, and open up new possibilities. You don’t need to have it all figured out to begin—just come as you are, with a willingness to get curious about yourself and what matters most to you.</p><DSButton href="/about" variant="secondary">More about my approach</DSButton></div>
    </div>
  </section>

  <section class="ds-section ds-section--subtle">
    <div class="ds-container ds-session-strip"><div><span class="ds-eyebrow">Sessions</span><h2>Virtual counselling on weekdays.</h2></div><div class="ds-session-strip__fees"><p><strong>50 minutes</strong><span>$150</span></p><p><strong>75 minutes</strong><span>$225</span></p></div></div>
  </section>

  <DSCTA title="Ready to start a conversation?" text="Reach out with any questions or if you’d like to find a time to connect." />
</BaseLayout>
