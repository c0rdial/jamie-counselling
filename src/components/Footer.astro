---
import { contactEmail } from "../lib/contact";
---
<footer class="ds-footer"><div class="ds-footer__inner">
  <div class="ds-footer__main">
    <div><div class="ds-footer__brand">Jamie Barbon Counselling</div><div class="ds-footer__tag">Clarity, compassion, and care.</div></div>
    <div class="ds-footer__cols">
      <nav class="ds-footer__col" aria-label="Footer navigation"><strong>Explore</strong><a href="/">Home</a><a href="/about">About</a><a href="/contact">Contact</a></nav>
      {contactEmail && <div class="ds-footer__col"><strong>Connect</strong><a href={`mailto:${contactEmail}`}>{contactEmail}</a></div>}
    </div>
  </div>
  <div class="ds-footer__bottom"><span>© {new Date().getFullYear()} Jamie Barbon Counselling</span><span>Virtual counselling in British Columbia</span></div>
</div></footer>
