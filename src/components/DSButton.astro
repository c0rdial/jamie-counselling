---
interface Props { href: string; variant?: "primary" | "secondary" | "light" | "glass"; size?: "sm" | "md" | "lg"; class?: string }
const { href, variant = "primary", size = "md", class: className = "" } = Astro.props;
---
<a href={href} class:list={["ds-button", `ds-button--${variant}`, `ds-button--${size}`, className]}><span><slot /></span><span class="ds-button__circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16m-7-7 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
