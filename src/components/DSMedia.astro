---
import SanityImage from "./SanityImage.astro";
import { Image } from "astro:assets";
interface Props { image?: any; src?: ImageMetadata; label: string; ratio?: string; tone?: "sand" | "sage" | "forest"; class?: string; eager?: boolean }
const { image, src, label, ratio = "4 / 5", tone = "sand", class: className = "", eager = false } = Astro.props;
---
<div class:list={["ds-media", `ds-media--${tone}`, className]} style={`--media-ratio: ${ratio}`}>
  {src ? <Image src={src} alt={label} widths={[320, 640, 960]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" loading={eager ? "eager" : "lazy"} /> : image?.asset ? <SanityImage image={image} alt={image.alt || label} sizes="(max-width: 700px) 100vw, 50vw" loading={eager ? "eager" : "lazy"} /> : <span aria-label={label} role="img">{label}</span>}
</div>
