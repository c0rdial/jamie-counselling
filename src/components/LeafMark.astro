---
interface Props {
  class?: string;
  showStem?: boolean;
  strokeWidth?: number;
}

const { class: className = "w-4 h-4", showStem = false, strokeWidth = 2 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth}>
  <path d="M12 3c-4 4-7 8-7 13a7 7 0 0014 0c0-5-3-9-7-13z" stroke-linecap="round" stroke-linejoin="round" />
  {showStem && <path d="M12 3v18" stroke-linecap="round" />}
</svg>
