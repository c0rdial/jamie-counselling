---
const currentPath = Astro.url.pathname;
const links = [
  { label: "Home", href: "/" }, { label: "About", href: "/about" },
  { label: "Resources", href: "/resources" }, { label: "Contact", href: "/contact" },
];
---
<header class="ds-nav"><div class="ds-nav__inner">
  <a class="ds-brand" href="/">Jamie Barbon <span>Counselling</span></a>
  <button class="ds-menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-links">Menu</button>
  <nav class="ds-nav__links" id="site-links" aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>)}
  </nav>
</div></header>
<script>
  const nav = document.querySelector<HTMLElement>('.ds-nav');
  const toggle = document.querySelector<HTMLButtonElement>('.ds-menu-toggle');
  const links = document.querySelector('.ds-nav__links');
  const setOpen = (open: boolean) => {
    links?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!links?.classList.contains('is-open')));
  addEventListener('keydown', event => {
    if (event.key !== 'Escape' || !links?.classList.contains('is-open')) return;
    setOpen(false);
    toggle?.focus();
  });
  addEventListener('click', event => {
    if (!nav?.contains(event.target as Node)) setOpen(false);
  });

  // Once the photo header scrolls away, the nav condenses into a floating island.
  const updateFloating = () => nav?.classList.toggle('is-floating', scrollY > 80);
  addEventListener('scroll', updateFloating, { passive: true });
  updateFloating();
</script>
