---
const currentPath = Astro.url.pathname;
const links = [
  { label: "Home", href: "/" }, { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---
<header class="ds-nav"><div class="ds-nav__inner">
  <a class="ds-brand" href="/">Jamie Barbon <span>Counselling</span></a>
  <button class="ds-menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-links">Menu</button>
  <nav class="ds-nav__links" id="site-links" aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>)}
  </nav>
</div></header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.ds-menu-toggle');
  const links = document.querySelector('.ds-nav__links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
